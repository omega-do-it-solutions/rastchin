{
  "name": "rastchin",
  "version": "0.1.0",
  "private": true,
  "description": "Persian-only RTL and localization tools for browsers, VS Code, desktop AI applications, and coding agents",
  "author": "Omega Do IT Solutions",
  "license": "Apache-2.0",
  "homepage": "https://github.com/omega-do-it-solutions/rastchin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omega-do-it-solutions/rastchin.git"
  },
  "bugs": {
    "url": "https://github.com/omega-do-it-solutions/rastchin/issues"
  },
  "engines": {
    "node": ">=24.18.1 <25"
  },
  "packageManager": "pnpm@11.14.0",
  "scripts": {
    "dev:browser": "pnpm --dir apps/browser-extension build:unpacked",
    "dev:firefox": "pnpm --dir apps/browser-extension build:firefox",
    "dev:vscode": "pnpm --dir apps/vscode-extension dev",
    "dev:desktop": "pnpm --dir apps/desktop-integrator dev",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "verify": "pnpm -r --if-present run verify && pnpm verify:agent-plugin && pnpm verify:release && pnpm verify:public",
    "verify:agent-plugin": "node scripts/verify-rastchin-persian-plugin.mjs",
    "verify:release": "node --test scripts/release-metadata.test.mjs && node scripts/release-metadata.mjs --verify-all",
    "verify:public": "node scripts/check-public-repo.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm verify",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "package:browser": "pnpm --dir apps/browser-extension package:all",
    "package:browser:chrome": "pnpm --dir apps/browser-extension package:store",
    "package:browser:firefox": "pnpm --dir apps/browser-extension package:firefox",
    "package:vscode": "pnpm --dir apps/vscode-extension package",
    "package:desktop:linux": "pnpm --dir apps/desktop-integrator package:linux"
  }
}
