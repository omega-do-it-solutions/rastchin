{
  "name": "@rastchin/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Persian-only public website for the RastChin tool suite",
  "license": "Apache-2.0",
  "homepage": "https://rastchin.tools",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omega-do-it-solutions/rastchin.git",
    "directory": "apps/web"
  },
  "bugs": {
    "url": "https://github.com/omega-do-it-solutions/rastchin/issues"
  },
  "engines": {
    "node": ">=24.18.1 <25"
  },
  "scripts": {
    "dev": "cross-env APP_ENV=development next dev",
    "build": "pnpm test && cross-env APP_ENV=production next build && node scripts/copy-legal-files.mjs",
    "start": "cross-env APP_ENV=production serve -l 3000 out",
    "preview": "pnpm start",
    "serve": "pnpm start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "pnpm verify:release && pnpm verify:platforms",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "verify:release": "node scripts/verify-release-sync.mjs",
    "verify:platforms": "node scripts/verify-platform-sync.mjs",
    "sync:release": "node scripts/sync-extension-release.mjs",
    "sync:release:check": "node scripts/sync-extension-release.mjs --check",
    "deploy:hetzner": "node scripts/deploy-hetzner.mjs",
    "deploy:hetzner:dry-run": "node scripts/deploy-hetzner.mjs --dry-run"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "next": "15.5.24",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "cross-env": "10.1.0",
    "daisyui": "5.7.22",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.24",
    "postcss": "8.5.26",
    "serve": "14.2.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
