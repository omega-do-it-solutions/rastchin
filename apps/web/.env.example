# The application scripts override this value for development and production.
APP_ENV=development

# Server-only feedback delivery. Leave secrets empty in committed files.
SENDGRID_API_KEY=
RASTCHIN_FEEDBACK_TO=
RASTCHIN_FEEDBACK_FROM=
RASTCHIN_FEEDBACK_FROM_NAME=RastChin
RASTCHIN_FEEDBACK_REPLY_TO=
RASTCHIN_FEEDBACK_REPLY_TO_NAME=RastChin
RASTCHIN_FEEDBACK_CONFIG=

# Optional manual Hetzner deployment. The deploy script requires these values
# from the invoking shell or an ignored local secret file.
HETZNER_HOST=
HETZNER_USER=
HETZNER_PORT=
HETZNER_REMOTE_PATH=
HETZNER_SSH_KEY=
HETZNER_SECRET_FILE=
