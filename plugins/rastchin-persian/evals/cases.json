    {
      "id": "S01",
      "mode": "structured",
      "context": "JSON localization resource",
      "input": "{\"save\":\"Save changes\",\"progress\":\"Uploading {{fileName}}… {{percent}}%\"}",
      "calibrationOutput": "{\"save\":\"ذخیرهٔ تغییرات\",\"progress\":\"در حال بارگذاری {{fileName}}… ٪{{percent}}\"}",
      "format": "json",
      "requiresPersian": true,
      "protectedTokens": ["{{fileName}}", "{{percent}}"],
      "checks": ["valid-json", "same-key-paths", "same-value-types", "preserve-token-multiset"]
    },
    {
      "id": "S02",
      "mode": "structured",
      "context": "ICU plural message",
      "input": "{count, plural, =0 {No files} one {# file} other {# files}}",
      "calibrationOutput": "{count, plural, =0 {فایلی نیست} one {# فایل} other {# فایل}}",
      "format": "icu",
      "requiresPersian": true,
      "protectedTokens": ["count", "plural", "=0", "one", "other", "#"],
      "checks": ["balanced-braces", "preserve-token-multiset", "preserve-selectors"]
    },
    {
      "id": "S03",
      "mode": "structured",
      "context": "HTML account welcome message",
      "input": "Welcome back, <strong>{{name}}</strong>. <a href=\"/settings\">Manage preferences</a>.",
